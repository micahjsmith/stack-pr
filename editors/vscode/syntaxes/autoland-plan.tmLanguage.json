{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Autoland Plan",
  "scopeName": "source.autoland-plan",
  "patterns": [
    {
      "include": "#comment-line"
    },
    {
      "include": "#land-url"
    },
    {
      "include": "#land-number"
    },
    {
      "include": "#land-bare"
    },
    {
      "include": "#land-invalid"
    },
    {
      "include": "#workflow"
    },
    {
      "include": "#workflow-missing"
    },
    {
      "include": "#confirm"
    },
    {
      "include": "#confirm-bare"
    },
    {
      "include": "#unknown-step"
    },
    {
      "include": "#comment-trailing"
    }
  ],
  "repository": {
    "comment-line": {
      "comment": "A line whose first non-blank character is '#' is ignored wholesale.",
      "match": "^[ \\t]*(#).*$",
      "name": "comment.line.number-sign.autoland-plan",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.autoland-plan"
        }
      }
    },
    "comment-trailing": {
      "comment": "The parser cuts a step at the first ' #', so the '#' must follow whitespace to start a comment: 'c ship it#now' is all condition.",
      "match": "(?<=[ \\t])(#).*$",
      "name": "comment.line.number-sign.autoland-plan",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.autoland-plan"
        }
      }
    },
    "land-url": {
      "comment": "l <url> — the URL shape mirrors RE_PR_URL in autoland.py.",
      "match": "^[ \\t]*(l)[ \\t]+(https?://[^/\\s]+/[^/\\s]+/[^/\\s]+/pull/\\d+/?)(?=[ \\t]*$|[ \\t]+#)",
      "captures": {
        "1": {
          "name": "keyword.control.land.autoland-plan"
        },
        "2": {
          "name": "markup.underline.link.autoland-plan"
        }
      }
    },
    "land-number": {
      "comment": "l <pr>",
      "match": "^[ \\t]*(l)[ \\t]+(\\d+)(?=[ \\t]*$|[ \\t]+#)",
      "captures": {
        "1": {
          "name": "keyword.control.land.autoland-plan"
        },
        "2": {
          "name": "constant.numeric.pr-number.autoland-plan"
        }
      }
    },
    "land-bare": {
      "comment": "A bare 'l' lands the next PR in the stack. 'l #123' is a bare 'l' with a comment, since '#' starts a comment.",
      "match": "^[ \\t]*(l)(?=[ \\t]*$|[ \\t]+#)",
      "captures": {
        "1": {
          "name": "keyword.control.land.autoland-plan"
        }
      }
    },
    "land-invalid": {
      "comment": "'l' takes a PR number or URL, so anything else is rejected by the parser.",
      "match": "^[ \\t]*(l)[ \\t]+((?:(?![ \\t]+#).)+)",
      "captures": {
        "1": {
          "name": "keyword.control.land.autoland-plan"
        },
        "2": {
          "name": "invalid.illegal.pr-reference.autoland-plan"
        }
      }
    },
    "workflow": {
      "comment": "w <workflow> — the name runs to the end of the step, spaces and all.",
      "match": "^[ \\t]*(w)[ \\t]+((?:(?![ \\t]+#).)+)",
      "captures": {
        "1": {
          "name": "keyword.control.workflow.autoland-plan"
        },
        "2": {
          "name": "entity.name.function.workflow.autoland-plan"
        }
      }
    },
    "workflow-missing": {
      "comment": "'w' requires a workflow name.",
      "match": "^[ \\t]*(w)(?=[ \\t]*$|[ \\t]+#)",
      "captures": {
        "1": {
          "name": "invalid.illegal.missing-workflow.autoland-plan"
        }
      }
    },
    "confirm": {
      "comment": "c [condition] — free text naming what to verify before proceeding.",
      "match": "^[ \\t]*(c)[ \\t]+((?:(?![ \\t]+#).)+)",
      "captures": {
        "1": {
          "name": "keyword.control.confirm.autoland-plan"
        },
        "2": {
          "name": "string.unquoted.condition.autoland-plan"
        }
      }
    },
    "confirm-bare": {
      "comment": "A bare 'c' just prompts 'Ready to proceed?'.",
      "match": "^[ \\t]*(c)(?=[ \\t]*$|[ \\t]+#)",
      "captures": {
        "1": {
          "name": "keyword.control.confirm.autoland-plan"
        }
      }
    },
    "unknown-step": {
      "comment": "Anything else makes the parser fail with 'unrecognized step'.",
      "match": "^[ \\t]*(\\S(?:(?![ \\t]+#).)*)",
      "captures": {
        "1": {
          "name": "invalid.illegal.unknown-step.autoland-plan"
        }
      }
    }
  }
}
